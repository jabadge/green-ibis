data_tools/check_version_updates/*_state.json

# --- Generated analysis outputs (regenerable from source data + scripts) ---
analyses/**/*_exports/
pdfs/
outputs/
results/
figures/

# --- Large scratch model runs ---
temp_models/
Models/

